{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aso-x.local/evidence-record.schema.json",
  "title": "ASO-X Evidence Record",
  "description": "Versioned evidence record schema for ASO-X operational, governance, CI, artifact, and release evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_type",
    "created_at",
    "producer",
    "subject",
    "summary",
    "integrity",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Evidence schema version.",
      "pattern": "^1\\.0\\.0$"
    },
    "evidence_id": {
      "type": "string",
      "description": "Stable unique evidence identifier.",
      "pattern": "^evd_[a-z0-9][a-z0-9_\\-]{15,127}$"
    },
    "evidence_type": {
      "type": "string",
      "description": "Type of evidence being recorded.",
      "enum": [
        "commit",
        "pull_request",
        "ci_run",
        "artifact",
        "policy_decision",
        "roadmap_milestone",
        "release_gate",
        "security_validation",
        "operator_action",
        "automation_run"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "UTC timestamp when the evidence record was created.",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "description": "Entity that produced the evidence record.",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "automation",
            "ci",
            "policy_engine",
            "release_system",
            "ai_assistant"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "subject": {
      "type": "object",
      "description": "Repository, commit, PR, artifact, or operation this evidence refers to.",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ref": {
          "type": "string",
          "description": "Branch, tag, commit, PR number, artifact id, or operational reference.",
          "minLength": 1,
          "maxLength": 300
        },
        "commit": {
          "type": "string",
          "description": "Git commit SHA when applicable.",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Short human-readable explanation of the evidence.",
      "minLength": 1,
      "maxLength": 2000
    },
    "policy_refs": {
      "type": "array",
      "description": "Policies or roadmap requirements supported by this evidence.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "description": "Artifacts, logs, files, reports, or durable outputs linked to this evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "uri"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "media_type": {
            "type": "string",
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "description": "Integrity metadata. Designed for cryptographic agility.",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "canonicalization"
      ],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "none"
          ]
        },
        "canonicalization": {
          "type": "string",
          "enum": [
            "json-canonical-v1",
            "none"
          ]
        },
        "content_hash": {
          "type": "string",
          "description": "Optional hash of canonicalized evidence content or linked payload.",
          "pattern": "^[a-f0-9]{64,128}$"
        },
        "signature": {
          "type": "object",
          "description": "Optional signature metadata for future cryptographic agility.",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "key_id": {
              "type": "string",
              "maxLength": 300
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "description": "Retention requirements for this evidence record.",
      "additionalProperties": false,
      "required": [
        "class",
        "minimum_years"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "temporary",
            "standard",
            "long_term",
            "permanent"
          ]
        },
        "minimum_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "immutable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
