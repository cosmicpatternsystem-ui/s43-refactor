{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "canonical_lock_count": {
      "const": 32,
      "type": "integer"
    },
    "locks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 10,
            "type": "string"
          },
          "enforcement": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^LOCK-[0-9]{3}$",
            "type": "string"
          },
          "name": {
            "minLength": 3,
            "type": "string"
          },
          "status": {
            "const": "canonical",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "enforcement",
          "description"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 32,
      "type": "array"
    },
    "project": {
      "const": "ASO-X",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "canonical_lock_count",
    "project",
    "locks"
  ],
  "title": "ASO-X Canonical Governance Lock Registry",
  "type": "object"
}
