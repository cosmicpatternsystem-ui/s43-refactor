#!/bin/sh
# ASO-X governance pre-commit hook (requires PowerShell 7+)
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
GUARD="$REPO_ROOT/.github/scripts/governance-guard.ps1"

if ! command -v pwsh >/dev/null 2>&1; then
  echo "PRE-COMMIT: FAIL - pwsh (PowerShell 7+) not found in PATH." >&2
  exit 1
fi

if [ ! -f "$GUARD" ]; then
  echo "PRE-COMMIT: FAIL - guard script missing: $GUARD" >&2
  exit 1
fi

pwsh -NoProfile -NoLogo -ExecutionPolicy Bypass -File "$GUARD"
exit $?
