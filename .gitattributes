# Enforce LF for source, roadmap, governance, and text artifacts.
* text=auto eol=lf

*.py    text eol=lf
*.ps1   text eol=lf
*.psm1  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Audit logs: integrity-sensitive, hash-chained. Never normalize bytes.
runtime/audit/** -text
*.jsonl -text

# Binary assets and archives: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.exe   binary
*.dll   binary
