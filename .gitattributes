# Enforce LF for source, roadmap, governance, and text artifacts.
* text=auto eol=lf

*.py    text eol=lf
*.ps1   text eol=lf
*.psm1  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Audit logs: integrity-sensitive, hash-chained. Never normalize bytes.
runtime/audit/** -text
*.jsonl -text

# Binary assets: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.7z    binary
*.pdf   binary