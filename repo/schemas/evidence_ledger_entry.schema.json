{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASO Evidence Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version",
    "entry_id",
    "recorded_at",
    "evidence_id",
    "evidence_path",
    "evidence_hash",
    "validator_schema",
    "validation_decision",
    "retention_class",
    "producer",
    "subject",
    "predecessor_entry_hash",
    "entry_hash"
  ],
  "properties": {
    "ledger_version": { "type": "string", "const": "1.0" },
    "entry_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "evidence_path": { "type": "string", "minLength": 1 },
    "evidence_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "validator_schema": { "type": "string", "minLength": 1 },
    "validation_decision": { "type": "string", "enum": ["pass", "fail"] },
    "retention_class": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "predecessor_entry_hash": { "type": "string" },
    "entry_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
