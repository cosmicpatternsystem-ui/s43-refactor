{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_id": "merge-safety.policy",
  "version": "1.0.0",
  "status": "active",
  "scope": "git/github",
  "intent": "Prevent unsafe merges, shadow authorities, and drift-based promotion.",
  "rules": [
    {
      "id": "block-unsafe-merge",
      "effect": "deny",
      "conditions": [
        "dirty worktree",
        "uncommitted governance drift",
        "failed governance guard",
        "missing review",
        "failed CI"
      ]
    }
  ]
}