root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.{ps1,psm1,py,js,json,md,yml,yaml,sh}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.jsonl]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false